{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/lawyer-portal", "dest": "/lawyer-portal.html" },
    { "src": "/documents", "dest": "/documents.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
